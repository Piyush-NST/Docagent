# Gemini semantic embeddings (server-side only)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Primary grounded answer provider (exact model only; no random-model routing)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Exact free OpenRouter vision model used only for OCR (no random routing)
OPENROUTER_OCR_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Embedding model (semantic retrieval)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Persistent document/chunk store (required on Vercel)
# Neon / Vercel Postgres / any Postgres URL
DATABASE_URL=
# Vercel Postgres integrations may provide this name instead
POSTGRES_URL=

# Storage backend override: postgres | file | memory
# Default: postgres if DATABASE_URL/POSTGRES_URL is set; else file (.data/) locally; memory for tests
# On Vercel without a Postgres URL the API returns 503 (no silent memory fallback)
DOCAGENT_STORAGE=

# Optional OCR page budget (default 10)
DOCAGENT_MAX_OCR_PAGES=10

# Private Vercel Blob store used for secure direct uploads above 4MB (up to 20MB)
# Added automatically when a Blob store is connected to the Vercel project
BLOB_READ_WRITE_TOKEN=

# Azure Blob for original file binaries (optional; local uses .data/blobs)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# Offline / CI mock mode (no live Gemini calls)
USE_MOCK_MODE=false
