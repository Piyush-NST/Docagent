# Gemini API Key - used for document chat answers and image OCR
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional Gemini chat model override
GEMINI_MODEL=gemini-2.0-flash

# Alternative: OpenAI (paid)
OPENAI_API_KEY=

# Azure Blob Storage (optional - uses in-memory if not set)
AZURE_STORAGE_CONNECTION_STRING=

# Mock mode
USE_MOCK_MODE=false
