# Gemini — chat answers, OCR, and semantic embeddings (server-side only)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Primary grounded answer provider (exact model only; no random-model routing)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Vision model used only for OCR fallback
GEMINI_OCR_MODEL=gemini-2.5-flash

# Embedding model (semantic retrieval)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Persistent document/chunk store (required on Vercel)
# Neon / Vercel Postgres / any Postgres URL
DATABASE_URL=

# Storage backend override: postgres | file | memory
# Default: postgres if DATABASE_URL set; else file (.data/) locally; memory for tests
# On Vercel without DATABASE_URL the API returns 503 (no silent memory fallback)
DOCAGENT_STORAGE=

# Optional OCR page budget (default 10)
DOCAGENT_MAX_OCR_PAGES=10

# Azure Blob for original file binaries (optional; local uses .data/blobs)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# Offline / CI mock mode (no live Gemini calls)
USE_MOCK_MODE=false
