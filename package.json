{
  "name": "doc-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "DOCAGENT_STORAGE=memory USE_MOCK_MODE=true tsx --test tests/**/*.test.ts evaluation/retrieval-fixtures.ts",
    "eval:retrieval": "DOCAGENT_STORAGE=memory USE_MOCK_MODE=true tsx --test evaluation/retrieval-fixtures.ts",
    "eval:answers": "DOCAGENT_STORAGE=file USE_MOCK_MODE=true tsx evaluation/answer-quality.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.30.0",
    "@google/generative-ai": "^0.24.1",
    "framer-motion": "^12.42.2",
    "mammoth": "^1.11.0",
    "next": "16.1.4",
    "pdf-to-img": "^5.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "unpdf": "^1.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
